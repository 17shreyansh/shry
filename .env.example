# Hostinger SMTP Configuration (Recommended)
# Hostinger SMTP host is usually smtp.hostinger.com
SMTP_HOST=smtp.hostinger.com
# Port 465 for SSL (recommended) or 587 for TLS
SMTP_PORT=465
# Your full Hostinger email address
SMTP_USER=hello@shry.in
# Your Hostinger email account password
SMTP_PASS=your_hostinger_email_password
# Where incoming enquiries should be received (defaults to SMTP_USER)
CONTACT_TO=hello@shry.in
# From header name & address
CONTACT_FROM="SHRY Website <hello@shry.in>"

# Alternative: Resend API (if you prefer Resend over SMTP)
# RESEND_API_KEY=re_123456789
