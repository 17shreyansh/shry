# Contact form delivery (https://resend.com). Without these, /api/contact returns 503 and the form shows a friendly notice.
RESEND_API_KEY=
CONTACT_TO=hello@yourdomain.com
# Optional. Must be a sender verified in Resend. Defaults to Resend's onboarding sender.
CONTACT_FROM="SHRY Website <hello@yourdomain.com>"
